node_modules/
dist/
# Los frames del arnés visual se regeneran con `npm run visual`; son grandes y
# cambian en cada corrida, así que no viven en el repo.
test/shots/
*.log
.DS_Store

# Buzones locales del canal agente↔agente y de las escalaciones. Estado de
# esta máquina, no código del proyecto.
.orca/

# Volcados del navegador que deja el MCP de Playwright al depurar la consola.
# Son artefactos de una sesión concreta, grandes y sin valor fuera de ella.
.playwright-mcp/

# Sobras de las corridas de autoverificación de agentes (scripts y salidas
# que el propio agente genera para comprobarse). No son código del proyecto.
orca-selftest/
